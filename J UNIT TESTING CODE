package com.mycompany.loginclass;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class LoginClassTest {

    // Username Tests

    @Test
    public void testValidUsername() {
        assertTrue(LoginClass.checkUserName("ab_cd"));
    }

    @Test
    public void testInvalidUsername_NoUnderscore() {
        assertFalse(LoginClass.checkUserName("abcd"));
    }

    @Test
    public void testInvalidUsername_TooLong() {
        assertFalse(LoginClass.checkUserName("abc_de"));
    }

    // Password Tests

    @Test
    public void testValidPassword() {
        assertTrue(LoginClass.checkPassword("Password1!"));
    }

    @Test
    public void testInvalidPassword_NoCapital() {
        assertFalse(LoginClass.checkPassword("password1!"));
    }

    @Test
    public void testInvalidPassword_NoNumber() {
        assertFalse(LoginClass.checkPassword("Password!"));
    }

    @Test
    public void testInvalidPassword_NoSpecialCharacter() {
        assertFalse(LoginClass.checkPassword("Password1"));
    }

    // Login Tests

    @Test
    public void testSuccessfulLogin() {
        assertTrue(LoginClass.login(
                "user_",
                "Password1!",
                "user_",
                "Password1!"
        ));
    }

    @Test
    public void testFailedLogin() {
        assertFalse(LoginClass.login(
                "user_",
                "WrongPass1!",
                "user_",
                "Password1!"
        ));
    }

    // Phone Number Tests

    @Test
    public void testValidPhoneNumber() {
        assertEquals(
                "Valid",
                LoginClass.validateNumber("+27831234567")
        );
    }

    @Test
    public void testInvalidPhoneNumber_WrongCountryCode() {
        assertEquals(
                "Invalid: must start with +27",
                LoginClass.validateNumber("+12831234567")
        );
    }

    @Test
    public void testInvalidPhoneNumber_Length() {
        assertEquals(
                "Invalid: must be 12 digits (+27XXXXXXXXX)",
                LoginClass.validateNumber("+2783123456")
        );
    }

    // Hash Tests

    @Test
    public void testCreateMessageHash() {

        String hash = LoginClass.createMessageHash(
                "1234567890",
                1,
                "Hello Java"
        );

        assertEquals(
                "12:1:HELLOJAVA",
                hash
        );
    }

    // Delete Message Tests

    @Test
    public void testDeleteMessageByHash() {

        LoginClass.ids.clear();
        LoginClass.hashes.clear();
        LoginClass.recipients.clear();
        LoginClass.messages.clear();
        LoginClass.timestamps.clear();
        LoginClass.statusList.clear();

        LoginClass.ids.add("1234567890");
        LoginClass.hashes.add("12:1:HELLOJAVA");
        LoginClass.recipients.add("+27831234567");
        LoginClass.messages.add("Hello Java");
        LoginClass.timestamps.add("12:00:00");
        LoginClass.statusList.add("SENT");

        LoginClass.deleteByHash("12:1:HELLOJAVA");

        assertEquals(0, LoginClass.messages.size());
    }

    // Search Tests

    @Test
    public void testMessageStoredCorrectly() {

        LoginClass.messages.clear();

        LoginClass.messages.add("JUnit Test Message");

        assertEquals(
                "JUnit Test Message",
                LoginClass.messages.get(0)
        );
    }
}
